<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces the single self-contained PdfTool.exe.

    dotnet publish PdfTool.App -c Release -p:PublishProfile=win-x64

  IncludeNativeLibrariesForSelfExtract is what actually keeps it to one file: PDFium and Skia
  are native, and without it they are emitted as loose DLLs beside the executable.
  PublishTrimmed is deliberately absent - trimming is not supported for WPF.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Without this, the .pdb shipped inside SkiaSharp's native package lands next to the
         executable and there is no longer a single file. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
