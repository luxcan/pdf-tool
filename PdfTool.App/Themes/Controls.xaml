<!--
    Control styles for the Precision theme.

    Every colour here is named, never literal, and reached with DynamicResource rather than
    StaticResource: the palette is a separate merged dictionary, so a swap repaints the running
    window instead of needing the styles rewritten. Metrics follow the handoff's control table -
    30 DIP controls, 3 DIP corners, 1 DIP borders.

    Only the controls this application actually shows are styled. The handoff specifies a dozen more
    (tree, slider, menu, date picker); adding them here would be shipping code with nothing to render
    it, and the palette they would need is already in place when one is wanted.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Typography ============================== -->
    <!-- The palette carries the reading face; these two are not colours and so are not its business.
         Glyphs come from the Windows icon font the handoff names - Fluent on 11, MDL2 on 10, the
         same codepoints in both - and never from emoji, which no theme can colour. -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================== Focus ============================== -->
    <!-- Drawn as an adorner outside the control's own border, which is why the margin is negative.
         Assigning it to FocusVisualStyle rather than triggering on IsKeyboardFocused is deliberate:
         WPF renders a focus visual only once focus has been moved by the keyboard, and the handoff
         asks for exactly that - a ring on tabbing, never on a mouse click. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2"
                            BorderBrush="{DynamicResource FocusVisual}"
                            BorderThickness="2"
                            CornerRadius="5"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Text ============================== -->
    <!-- No Foreground here on purpose: this style also reaches text generated inside control
         templates, which has to inherit the colour of whatever it sits on - the dark ink of
         AccentForeground on a primary button, TextPrimary on a panel. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Secondary, not disabled: TextDisabled marks controls the user cannot use and is too faint
         to read prose in, which is what the handoff's accessibility note is about. -->
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="Foreground" Value="{DynamicResource ValidationError}" />
    </Style>

    <!-- A link reads as running text until it is pointed at, which is where the accent and the rule
         underneath it come from. The underline is cleared rather than left off, because Hyperlink
         draws one by default. -->
    <Style x:Key="Link" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBackground}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBackground}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Row text that carries less weight than the file name beside it. -->
    <Style x:Key="SecondaryCellText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryCellText}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ============================== Buttons ============================== -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The accent is light and its text is dark, which is the point of AccentForeground: the same
         hex in both modes would fail contrast in one of them. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        <Setter Property="Background" Value="{DynamicResource AccentBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBackgroundHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBackgroundPressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBackgroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Separator ============================== -->
    <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource ControlBorder}" />
        <Setter Property="Margin" Value="4,4,10,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================== Scrollbars ============================== -->
    <!-- Overlay-styled and arrowless. The handoff has the bar itself growing from 6 to 12 DIP on
         approach; the slot is kept at a constant 12 and the thumb grown inside it instead, because
         a WPF ScrollBar occupies layout space and changing its width would reflow the list under
         the pointer. What the eye is given - a hairline that thickens - is the same. -->
    <Style x:Key="VerticalScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Transparent full-width host so the whole bar is grabbable; the visible bar
                         is the inner border, inset by its margin. -->
                    <Border Background="Transparent">
                        <Border x:Name="Bar"
                                Margin="4,2"
                                Background="{DynamicResource ScrollBarThumb}"
                                CornerRadius="6" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                                     Value="True">
                            <Setter TargetName="Bar" Property="Margin" Value="2,2" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollBarThumbHover}" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Margin" Value="2,2" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HorizontalScrollBarThumb" TargetType="Thumb" BasedOn="{StaticResource VerticalScrollBarThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Bar"
                                Margin="2,4"
                                Background="{DynamicResource ScrollBarThumb}"
                                CornerRadius="6" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                                     Value="True">
                            <Setter TargetName="Bar" Property="Margin" Value="2,2" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollBarThumbHover}" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Margin" Value="2,2" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page buttons a Track expects still have to exist, or clicking the empty half of the
         bar does nothing; they simply draw no chrome. -->
    <Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeatButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource VerticalScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeatButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ScrollBarTrack}" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <!-- The width pinned above is the vertical bar's thickness. Left set, it
                                 becomes a horizontal bar's length, and the bar arrives as a 12 DIP
                                 stub in the corner. -->
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="12" />
                            <Setter Property="MinHeight" Value="12" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="Thumb" Property="Style" Value="{StaticResource HorizontalScrollBarThumb}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Lists ============================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- The 2 DIP accent rail on the left edge is always in the border, transparent until the row
         is selected, so selecting one never nudges its contents sideways. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2,0,0,0"
                            CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                        <!-- After the plain selected case, or the hover fill would be overwritten by
                             it and the palette's hover-on-selection colour would never appear. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBackgroundHover}" />
                        </MultiTrigger>
                        <!-- A list that has lost focus still has to show what is selected, quietly. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionUnfocused}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Segmented selector ============================== -->
    <!-- A handful of mutually exclusive choices, all visible at once: one click, nothing hidden
         behind a drop-down. The active segment is the handoff's selection fill rather than a solid
         accent - four of these sit on one screen, and four accent blocks would fight each other. -->
    <Style x:Key="SegmentedItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedSelector" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedItem}" />

        <!-- One segment: the quality presets, the split modes and the page picker's tile size all
             carry a short name and a longer explanation, so the style can label them all. -->
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== File table ============================== -->
    <!-- Read-only grid: no editing, no sorting - row order is the merge order and must stay put. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="RowHeight" Value="30" />
        <!-- Banding is driven from the row style's alternation trigger rather than the grid's own
             AlternatingRowBackground, so that hover and selection - which are triggers too - reliably
             win over it instead of racing the grid's property transfer. -->
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ColumnHeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource SurfaceAltBackground}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>

                        <!-- Separates one column's title from the next; a hairline, not the header's
                             own outline, so the two do not read as the same rule. -->
                        <Rectangle Width="1"
                                   Margin="0,6"
                                   HorizontalAlignment="Right"
                                   Fill="{DynamicResource Divider}"
                                   SnapsToDevicePixels="True" />

                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Style="{StaticResource ColumnHeaderGripper}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <!-- Left edge reserved for the selection rail at all times; see the ListBoxItem note. -->
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource RowAlternating}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundHover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SelectionUnfocused}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Check box ============================== -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Width="11"
                                  Height="11"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentForeground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  Data="M 2,6 L 5,9 L 10,2" />
                        </Border>
                        <ContentPresenter x:Name="Label"
                                          Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBackground}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlBackgroundDisabled}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlBorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Text box ============================== -->
    <!-- The split tab's two inputs. Left unstyled they arrive in WPF's own light chrome: a white
         field in the middle of a dark window. -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBackground}" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <!-- Claims the right-click menu before WPF can supply its own unstyled one; see the context
             menu section below. Dynamic because that resource is declared further down. -->
        <Setter Property="ContextMenu" Value="{DynamicResource TextBoxContextMenu}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ValidationError}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Tabs ============================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1" />

                        <!-- Pulled up by one pixel so the selected tab, which carries the same fill,
                             joins the body instead of sitting on a line above it. -->
                        <Border Grid.Row="1"
                                Margin="0,-1,0,0"
                                Background="{DynamicResource SurfaceAltBackground}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="0,3,3,3"
                                Padding="12">
                            <!-- The part name is what lets WPF hand the tab's content to automation
                                 and screen readers; without it the tab reads as empty. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root"
                            Height="32"
                            Margin="0,0,3,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="3,3,0,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- The active tab's mark, inset inside its own border. -->
                            <Rectangle x:Name="ActiveRule"
                                       Height="2"
                                       Margin="1,1,1,0"
                                       VerticalAlignment="Top"
                                       Fill="{DynamicResource AccentBackground}"
                                       Visibility="Collapsed" />

                            <ContentPresenter x:Name="Label"
                                              ContentSource="Header"
                                              Margin="18,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
                            <Setter TargetName="ActiveRule" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Progress bar ============================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource ControlBorderDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Context menus ============================== -->
    <!-- Nothing in this application opens a menu of its own, but a TextBox carries Windows' editing
         menu whether or not anyone asked for it, and unstyled that arrives as a white Cut/Copy/Paste
         block in the middle of a dark window - the same fault as the unstyled tooltip, one control
         further along.

         Styling ContextMenu and MenuItem is not enough to reach it. WPF builds that menu from
         internal types derived from ContextMenu and MenuItem, and an implicit style is keyed on the
         exact type, so it never applies - the menu keeps its 22 DIP default rows and its light
         chrome. The way to theme it is to stop it being built: a TextBox that already has a
         ContextMenu does not get the internal one, and an ordinary menu of the same three commands
         does answer to the styles below. The commands carry their own labels and shortcut text, and
         disable themselves when they do not apply. -->
    <ContextMenu x:Key="TextBoxContextMenu" x:Shared="False">
        <MenuItem Command="ApplicationCommands.Cut" />
        <MenuItem Command="ApplicationCommands.Copy" />
        <MenuItem Command="ApplicationCommands.Paste" />
    </ContextMenu>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- The margin is what gives the shadow somewhere to fall inside the popup. -->
                    <Border Margin="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="0,4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="10"
                                              Direction="270"
                                              Color="Black"
                                              Opacity="0.32" />
                        </Border.Effect>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Margin="4,0"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- The gutter keeps every label on one line whether or not the item
                                     carries an icon or a tick. -->
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="Icon"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                            <Path x:Name="Check"
                                  Grid.Column="0"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBackground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 2,6 L 5,9 L 10,2" />

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <TextBlock Grid.Column="2"
                                       Margin="28,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextDisabled}" />

                            <Path x:Name="Arrow"
                                  Grid.Column="3"
                                  Margin="12,0,2,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Fill="{DynamicResource TextPrimary}"
                                  Data="M 0,0 L 4,4 L 0,8 Z" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Right"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Margin="6"
                                        Background="{DynamicResource SurfaceAltBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          ShadowDepth="10"
                                                          Direction="270"
                                                          Color="Black"
                                                          Opacity="0.32" />
                                    </Border.Effect>
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Menus track the pointer and the arrow keys together, which is what
                             IsHighlighted means and IsMouseOver alone would miss. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <!-- A hairline centred in a 9 DIP block, so the rule reads as a gap with a line
                         in it rather than as a squeezed row. -->
                    <Border Height="9" Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle Height="1"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Divider}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Tooltips ============================== -->
    <!-- Several of the app's tooltips are whole sentences, so they wrap against a maximum rather
         than running off the side of the screen. The margin is what gives the shadow room to fall
         inside the popup. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TooltipForeground}" />
        <Setter Property="Background" Value="{DynamicResource TooltipBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorder}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="5"
                            MaxWidth="320"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
                            Padding="9,6"
                            SnapsToDevicePixels="True">
                        <Border.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </Border.Resources>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="4"
                                              Direction="270"
                                              Color="Black"
                                              Opacity="0.35" />
                        </Border.Effect>
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
