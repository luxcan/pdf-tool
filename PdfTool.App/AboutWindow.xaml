<Window x:Class="PdfTool.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PDF Tool"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource FontSizeBody}"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- DataContext is an AboutInfo, set in the constructor. The title bar is the one Windows draws,
         turned dark by DarkTitleBar like every other window here; the handoff draws its own only
         because HTML has no window frame to borrow. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,22">

            <!-- ============================== Identity ============================== -->
            <StackPanel Orientation="Horizontal">
                <Border Width="52"
                        Height="52"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBackground}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <TextBlock Text="PDF"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Margin="15,1,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />

                    <TextBlock Text="{Binding VersionAndBuild}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,4,0,0" />

                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               HorizontalAlignment="Left"
                               LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- ============================== Updates ============================== -->
            <!-- Nothing here reaches the network. The button hands an address to the shell, which is
                 the only update check an application that never opens a socket can honestly offer. -->
            <Border Margin="0,18,0,0"
                    Padding="16,15"
                    Background="{DynamicResource SurfaceAltBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16"
                                Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource AccentBackground}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="9"
                                       Foreground="{DynamicResource AccentForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Updates"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Releases are published on GitHub &#8212; open the page below to see whether a newer build is available and what changed in it."
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               LineHeight="19"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,11,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                MinWidth="0"
                                Padding="14,0"
                                Margin="0,0,9,0"
                                Click="OnReleasesRequested"
                                ToolTip="Opens the releases page in your browser.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open releases page" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE8A7;"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Wide enough for the longest thing it says, so confirming a copy does not
                             shift the row it sits in. -->
                        <Button x:Name="CopyLinkButton"
                                Content="Copy link"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="92"
                                Padding="13,0"
                                Margin="0,0,9,0"
                                Click="OnCopyLinkRequested"
                                ToolTip="Copies the releases address to the clipboard." />

                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{DynamicResource MonospaceFontFamily}"
                                   FontSize="11.5">
                            <Hyperlink Style="{StaticResource Link}"
                                       NavigateUri="{Binding ReleasesUrl}">
                                <Run Text="{Binding RepositoryLabel, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <Rectangle Height="1"
                               Margin="0,11,0,0"
                               Fill="{DynamicResource Divider}" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}"
                               LineHeight="17"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,9,0,0">
                        <Run Text="Downloads are a single" />
                        <Run Text="PdfTool.exe"
                             FontFamily="{DynamicResource MonospaceFontFamily}"
                             FontSize="11"
                             Foreground="{DynamicResource TextPrimary}" /><Run Text=" &#8212; nothing to install. The file is not code-signed, so Windows SmartScreen may warn you the first time you run a new build." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================== Footer ============================== -->
        <Border Grid.Row="1"
                Height="52"
                Padding="24,0"
                Background="{DynamicResource SurfaceAltBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5">
                        <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding IssuesUrl}">
                            <Run Text="Report an issue" />
                        </Hyperlink>
                    </TextBlock>

                    <Rectangle Width="1"
                               Height="14"
                               Margin="10,0"
                               Fill="{DynamicResource Divider}" />

                    <TextBlock FontSize="12.5">
                        <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding RepositoryUrl}">
                            <Run Text="View source" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <Button Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="84"
                        Padding="16,0"
                        Margin="0"
                        IsDefault="True"
                        IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
