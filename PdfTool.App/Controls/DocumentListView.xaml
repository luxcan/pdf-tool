<UserControl x:Class="PdfTool.App.Controls.DocumentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="NumericColumnHeader"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="NameCellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- The row carries the full path, so no column has to be wide enough to show it. -->
        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ToolTip" Value="{Binding FilePath}" />
        </Style>
    </UserControl.Resources>

    <!-- DataContext is a DocumentListViewModel; both tabs bind their own instance. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- List actions on the left, the owning tab's primary action on the right. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Add files..."
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding PromptForFilesCommand}" />
                <Button Content="Remove"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RemoveCommand}" />
                <Button Content="Move up"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding MoveUpCommand}"
                        Visibility="{Binding ShowReorderButtons, ElementName=Root,
                                    Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Move down"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding MoveDownCommand}"
                        Visibility="{Binding ShowReorderButtons, ElementName=Root,
                                    Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}" />
            </StackPanel>

            <!-- A ContentControl, not a ContentPresenter: only the former adopts the hosted buttons
                 into the logical tree, which is what their bindings back to the window rely on. -->
            <ContentControl Content="{Binding ToolbarContent, ElementName=Root}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}"
                      Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File"
                                        Width="2*"
                                        Binding="{Binding FileName}"
                                        ElementStyle="{StaticResource NameCellText}" />
                    <DataGridTextColumn Header="Pages"
                                        Width="72"
                                        Binding="{Binding PageCount}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Size"
                                        Width="90"
                                        Binding="{Binding SizeText}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Folder"
                                        Width="3*"
                                        Binding="{Binding FolderPath}"
                                        ElementStyle="{StaticResource SecondaryCellText}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state, replaced by the table as soon as a file is added -->
            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasDocuments, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Drop PDF files here"
                               FontSize="17"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="or use Add files..."
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
